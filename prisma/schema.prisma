generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BirthdayAudience {
  ALL
  SELECTED
  PRIVATE
}

enum PersonalEventRecurrence {
  ONCE
  YEARLY
}

enum HolidayRuleKind {
  FIXED
  NTH_WEEKDAY
}

enum HolidayTheme {
  MALE
  FEMALE
}

enum ProfileGender {
  MALE
  FEMALE
}

enum CalendarReminderSourceType {
  BIRTHDAY
  PERSONAL
  HOLIDAY
}

enum ItemStatus {
  AVAILABLE
  PURCHASED
}

model User {
  id            String        @id @default(cuid())
  username      String        @unique
  password      String
  name          String
  avatarUrl     String?
  telegramId    String?       @unique
  telegramUsername String?
  telegramLinkedAt DateTime?
  telegramConfirmedAt DateTime?
  telegramNotificationsEnabled Boolean @default(false)
  calendarNotificationsEnabled Boolean @default(true)
  giftPreferences Json?
  gender        ProfileGender?
  thematicHolidayConsent Boolean @default(false)
  birthdayDay   Int?
  birthdayMonth Int?
  birthdayYear  Int?
  birthdayAudience BirthdayAudience @default(PRIVATE)
  birthdayViewers BirthdayViewer[] @relation("BirthdayOwner")
  visibleBirthdays BirthdayViewer[] @relation("BirthdayViewer")
  personalEvents PersonalEvent[]
  visiblePersonalEvents PersonalEventViewer[]
  calendarEventMutes CalendarEventMute[]
  calendarReminderDeliveries CalendarReminderDelivery[]
  role          Role          @default(USER)
  items         Item[]
  lists         List[]
  listViewers   ListViewer[]
  itemComments  ItemComment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([username])
  @@index([role])
  @@index([telegramConfirmedAt])
}

model CalendarEventMute {
  userId     String
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType CalendarReminderSourceType
  sourceId   String
  createdAt  DateTime                   @default(now())

  @@id([userId, sourceType, sourceId])
  @@index([sourceType, sourceId])
}

model CalendarReminderDelivery {
  id             String                     @id @default(cuid())
  recipientId    String
  recipient      User                       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  sourceType     CalendarReminderSourceType
  sourceId       String
  occurrenceDate String                     @db.VarChar(10)
  checkpointDays Int
  createdAt      DateTime                   @default(now())

  @@unique([recipientId, sourceType, sourceId, occurrenceDate, checkpointDays])
  @@index([occurrenceDate])
}

model CalendarInstallationSettings {
  id        Int      @id @default(1)
  timeZone  String   @default("Europe/Moscow") @db.VarChar(100)
  updatedAt DateTime @updatedAt
}

model PersonalEvent {
  id          String                  @id @default(cuid())
  ownerId     String
  owner       User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String                  @db.VarChar(200)
  description String?                 @db.VarChar(2000)
  localDate   String                  @db.VarChar(10)
  recurrence  PersonalEventRecurrence
  audience    BirthdayAudience        @default(PRIVATE)
  viewers     PersonalEventViewer[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([ownerId])
  @@index([localDate])
  @@index([audience])
}

model PersonalEventViewer {
  eventId  String
  event    PersonalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User          @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([eventId, viewerId])
  @@index([viewerId])
}

model BirthdayViewer {
  ownerId String
  owner   User   @relation("BirthdayOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewerId String
  viewer   User   @relation("BirthdayViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([ownerId, viewerId])
  @@index([viewerId])
}

model Holiday {
  id               String          @id @default(cuid())
  seedKey          String?         @unique
  name             String
  ruleKind         HolidayRuleKind
  month            Int
  day              Int?
  weekday          Int?
  occurrence       Int?
  enabled          Boolean         @default(true)
  remindersEnabled Boolean         @default(true)
  theme             HolidayTheme?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([enabled])
}

model List {
  id        String       @id @default(cuid())
  name      String
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Item[]
  viewers   ListViewer[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model ListViewer {
  listId   String
  list     List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([listId, userId])
  @@index([userId])
}

model Item {
  id          String        @id @default(cuid())
  title       String
  url         String?
  price       Float?
  currency    String        @default("RUB")
  priority    Int           @default(3) // 1-5
  images      String[] // Array of image URLs
  notes       String?
  purchased   Boolean       @default(false)
  purchasedAt DateTime?
  status      ItemStatus    @default(AVAILABLE)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listId      String?
  list        List?         @relation(fields: [listId], references: [id], onDelete: SetNull)
  category    String?
  comments    ItemComment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([listId])
  @@index([purchased])
  @@index([createdAt])
  @@index([userId, purchased])
  @@index([userId, createdAt])
  @@index([status])
  @@index([category])
}

model ItemComment {
  id        String   @id @default(cuid())
  text      String   @db.VarChar(2000)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([userId])
}
