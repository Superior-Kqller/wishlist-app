{
  "name": "wishlist",
  "version": "1.9.6",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "prisma db push",
    "db:local": "node ./node_modules/@electric-sql/pglite-socket/dist/scripts/server.js --db=./.tmp/pglite --host=127.0.0.1 --port=5432 --max-connections=8",
    "db:check-migrations": "node scripts/check-prisma-migrations.mjs",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@electric-sql/pglite-socket": "^0.2.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@serwist/next": "^9.5.12",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prisma": "^7.9.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@prisma/dev": "0.24.17",
    "browserslist": "^4.28.8",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.22.0",
    "postcss": "^8.5.13",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1",
    "valibot": "^1.4.2"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true
  }
}
