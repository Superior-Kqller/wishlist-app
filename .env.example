# -----------------------------------------------------------------------------
# Required for Docker
# -----------------------------------------------------------------------------

# PostgreSQL password used by docker-compose.prod.yml.
# Not needed when running docker-compose.pglite.yml.
DB_PASSWORD=replace-with-a-strong-postgres-password

# Public URL of the app. For local Docker testing you can use:
# NEXTAUTH_URL=http://localhost:4030
NEXTAUTH_URL=https://wishlist.example.com

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Host port exposed by docker-compose.prod.yml.
APP_PORT=4030

# Initial users created on first setup. Use strong non-default passwords.
SEED_USER1_USERNAME=admin
SEED_USER1_PASSWORD=replace-with-a-strong-admin-password
SEED_USER1_NAME=Admin

SEED_USER2_USERNAME=user
SEED_USER2_PASSWORD=replace-with-a-strong-user-password
SEED_USER2_NAME=User

# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------

# Used by Prisma when running the app outside Docker.
# docker-compose.dev.yml uses DB_PASSWORD as the local database password.
# DATABASE_URL=postgresql://wishlist:replace-with-a-strong-postgres-password@localhost:5432/wishlist

# Host port for docker-compose.dev.yml PostgreSQL.
# POSTGRES_PORT=5432

# Локальная база без Docker: `npm run db:local` поднимает встроенный PGlite
# на 127.0.0.1:5432 (тот же путь, что в docker-compose.pglite.yml), после чего
# `npm run db:push` и `npm run db:seed` работают как с обычным PostgreSQL.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Disable service worker during local development.
# DISABLE_PWA=1

# -----------------------------------------------------------------------------
# Reverse proxy
# -----------------------------------------------------------------------------

# Set this when the app is behind a trusted reverse proxy and NEXTAUTH_URL is the
# external HTTPS URL.
# AUTH_TRUST_HOST=true

# -----------------------------------------------------------------------------
# Telegram bot (optional)
# -----------------------------------------------------------------------------

# BotFather token, format: 123456789:AA...
# TELEGRAM_BOT_TOKEN=

# Comma-separated private, group, or supergroup chat IDs for notifications.
# To discover an ID, add the bot to the chat and send /chatid.
# TELEGRAM_CHAT_IDS=

# Optional secret for the interactive webhook mode. Public HTTPS is required.
# TELEGRAM_WEBHOOK_SECRET=

# Webhook endpoint:
# https://wishlist.example.com/api/integrations/telegram/webhook

# -----------------------------------------------------------------------------
# Redis / Valkey (optional)
# -----------------------------------------------------------------------------

# If unset, the app falls back to in-memory rate limiting/cache.
# Production with Valkey:
# docker compose -f docker-compose.prod.yml -f docker-compose.valkey.yml up -d
# Production with embedded PGlite:
# docker compose -f docker-compose.pglite.yml -f docker-compose.valkey.yml up -d
# Local development with Valkey:
# docker compose -f docker-compose.dev.yml --profile cache up -d
# REDIS_URL=/run/valkey/valkey.sock
# REDIS_URL=redis://localhost:6379
# VALKEY_PORT=6379

# -----------------------------------------------------------------------------
# Deployment options (optional)
# -----------------------------------------------------------------------------

# docker-compose.prod.yml has a default image. Pin a version tag for repeatable
# deployments instead of relying on latest.
# WISHLIST_APP_IMAGE=ghcr.io/superior-kqller/wishlist-app:latest

# The app container runs migrations and seed by default on startup.
# RUN_MIGRATIONS_ON_START=1

# Use docker-compose.pglite.yml to run a PostgreSQL-compatible embedded PGlite
# database in the app container. Data is stored in the pglite-data Docker volume.
# DATABASE_PROVIDER=pglite
# PGLITE_DATA_DIR=/app/data/pglite
# PGLITE_PORT=5432

# Usually passed at Docker build time from a git tag.
# APP_VERSION=1.8.8

# Allowed external hosts for user avatar URLs, comma-separated. Product photos
# are allowed from HTTPS domains separately by next/image config.
# AVATAR_ALLOWED_HOSTS=cdn.example.com,images.example.com
